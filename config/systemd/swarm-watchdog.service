[Unit]
Description=workout-agent AI Swarm Watchdog (oneshot check)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/dev/workout-agent
ExecStart=%h/dev/workout-agent/scripts/watchdog.sh
EnvironmentFile=-%h/dev/workout-agent/.env
EnvironmentFile=-%h/dev/workout-agent/.env.swarm
