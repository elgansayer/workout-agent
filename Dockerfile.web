# Stage 1: Build Angular Frontend
FROM node:22-alpine AS frontend-builder
WORKDIR /build
COPY frontend/package*.json ./
RUN npm install --legacy-peer-deps
COPY frontend/ ./
RUN npm run build

# Stage 2: Production Python Webapp
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DATABASE_PATH=/data/workout_agent.db \
    APP_ENV=production \
    ALLOW_ANONYMOUS_WEB=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt backend/requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-web.txt

COPY backend/ .
RUN mkdir -p /data /app/frontend/dist

# Copy the built Angular app from Stage 1
COPY --from=frontend-builder /build/dist /app/frontend/dist

EXPOSE 8000
CMD ["uvicorn", "webapp.secure_app:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
