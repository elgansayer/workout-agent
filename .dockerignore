# Keep the image small and never bake secrets or local state into it.
.venv/
__pycache__/
*.pyc
.git/
.gitignore
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
*.db
*.sqlite
*.sqlite3
.env
*.log
*.md
!README.md

# Node / Frontend build artifacts
frontend/node_modules/
frontend/.angular/
node_modules/

# Binary images -- never bake stray image files into images
*.png
*.jpg
*.jpeg
*.gif
*.ico
