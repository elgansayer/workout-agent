# .env.swarm.example - configuration for swarmd.py (the autonomous coding
# swarm), separate from the application's own .env (which configures the
# workout-agent product itself: Gemini key, Telegram, Hevy, etc).
#
# Copy to .env.swarm and fill in what you want the swarm to use. Both
# scripts/swarm-env.sh and config/systemd/*.service load this file
# automatically. Nothing here is required to run the app itself.

# --- Model CLIs -------------------------------------------------------
# claude: needs the `claude` CLI logged in (no API key env var required).
# antigravity: needs `agy`/`antigravity` CLI + GEMINI_API_KEY.
# copilot: needs `aider` + OPENAI_API_KEY (routed at api.githubcopilot.com).
# deepseek: needs `aider` + DEEPSEEK_API_KEY.
#
# aider is installed in an isolated Python 3.12 `uv tool` environment on
# this host (this project's own .venv is Python 3.14, which the
# numpy/scipy chain aider depends on doesn't have wheels for yet) - see
# `uv tool install --python 3.12 aider-chat` if you need to reinstall it.

GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY is not needed here - the `claude` CLI uses its own login.

# Order the swarm rotates through when picking a model each cycle.
# SWARM_MODEL_ORDER=claude,antigravity,copilot,deepseek

# --- Repo identity ------------------------------------------------------
# SWARM_REPO_OWNER=elgansayer
# SWARM_REPO_NAME=workout-agent
# SWARM_GIT_REMOTE=origin
# SWARM_GIT_BRANCH=main
# SWARM_GIT_USER=AI Swarm
# SWARM_GIT_EMAIL=swarm@workout-agent.local

# --- GitHub issue sync (optional - requires `gh` CLI authenticated) -----
# Used to import .agents/automations/*.md (queued hourly/daily/weekly by
# .github/workflows/agent-*.yml) as tasks, and to close issues on completion.
# No token needed here if `gh auth login` is already set up on this host.

# --- Loop behaviour / timeouts ------------------------------------------
# SWARM_MAX_RETRIES=2
# SWARM_COOLDOWN=15
# SWARM_STUCK_TIMEOUT=300
# SWARM_TEST_TIMEOUT=180
# AI_RATE_COOLDOWN_SECONDS=15
# SWARM_DISCOVER_TIMEOUT=180
# SWARM_GH_SYNC_CYCLES=20
# SWARM_REVIEW_CYCLES=5
# SWARM_FIX_MAX_ROUNDS=5
# SWARM_STUCK_ALERT_SECONDS=900
# SWARM_STUCK_RESTART_SECONDS=2700

# Downgrade the verification gate to advisory-only (commits even if lint/
# tests fail). Off by default - only use this deliberately, e.g. to let the
# swarm push forward past a pre-existing broken-test state you're aware of.
# SWARM_RELAXED_TESTS=

# --- Watchdog alerts (optional - reuses the app's own Telegram bot) -----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SWARM_ALERT_CHAT_ID=
