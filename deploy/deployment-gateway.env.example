# Install as /etc/workout-agent/deployment-gateway.env with mode 0600.
DATABASE_PATH=/srv/workout-agent/data/workout_agent.db
BACKUP_DIRECTORY=/srv/workout-agent/backups
DEPLOYMENT_RECORD_DIRECTORY=/srv/workout-agent/deployment-records
ARCANE_WEBHOOK_URL=http://127.0.0.1:3552/api/stacks/workout-agent/deploy
ARCANE_BEARER_TOKEN=
DEPLOY_WEBHOOK_TOKEN=
BACKUP_ENCRYPTION_KEYS=production-v1:REPLACE_WITH_FERNET_KEY
BACKUP_ACTIVE_KEY_ID=production-v1
