# Copy this file to .env and fill in your real values. Never commit .env.

# Optional server-side Gemini fallback. Authenticated users can instead
# save any supported provider key in Settings.
GEMINI_API_KEY=

# Push Notifications (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Agent scheduler: which HH:MM times to run the daily agent (comma-separated).
# The scheduler wakes once per minute and dispatches `main.py` at these times
# in the timezone specified by TZ. Default: 07:00.
RUN_AT=00:00,05:00
# Timezone for RUN_AT scheduling (IANA name, e.g. Europe/London). Default: UTC.
TZ=Europe/London

# Per-user settings (Hevy, Health Connect, AI keys) are configured in the Web UI
# and stored securely in the database.


# Every 4-6 weeks the agent runs a routine check-in: it reads your logged Hevy
# history, compares planned vs actual progress per lift, auto-applies the
# findings and sends you a Telegram digest. Set to 0 to disable check-ins.
CHECKIN_ENABLED=1

# Append a daily "what to do today" lifestyle plan (today's session, carb
# cycling, cardio and steps, CNS recovery) to each message, and log it. Set to
# 0 to disable.
LIFESTYLE_ENABLED=1

# Weekly self-review: once a week the agent analyses your Hevy and Google Health
# trends (which lifts are progressing, stalling or regressing, plus recovery)
# and sends a short Telegram digest. Set 0 to disable. SELF_REVIEW_WEEKDAY is the
# day it sends (Mon-Sun, or 0-6 with Monday=0); defaults to Sunday.
SELF_REVIEW_ENABLED=1
SELF_REVIEW_WEEKDAY=Sun

# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
# Absolute path to the JSON file exported from Google Health Connect (optional).
# Include body_fat_pct and muscle_pct (e.g. from a Eufy Life scale synced via
# Health Connect) and the agent will log your body composition too.
HEALTH_CONNECT_FILE=

# Automatic body-composition sync (optional, no manual export). A Eufy Life scale
# syncs weight and body fat to Fitbit / Google Health; the agent then reads them
# from the Google Health Web API each run. Create an OAuth client at
# https://developers.google.com/health/setup, then either link it from the web
# dashboard's Settings page (click "Connect Google Health" — no token needed), or
# run `python google_health_auth.py` once to seal a refresh token in the vault.
# The refresh-token env var is a legacy fallback for the legacy tenant only.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REFRESH_TOKEN=
# Only needed to link Google Health from the web dashboard: the public callback
# URL of the dashboard, also added as an Authorized redirect URI on the OAuth
# client, e.g. https://gym.example.com/google-health/callback
GOOGLE_HEALTH_REDIRECT_URI=
# Path to the SQLite database file (optional)
DATABASE_PATH=workout_agent.db
# Telegram parse mode for formatting. Leave blank for plain text, or set to
# MarkdownV2 to enable formatting (plain text is escaped automatically).
TELEGRAM_PARSE_MODE=

# --- Web App Security ---
# APP_ENV must always be explicit. The production image defaults to production;
# this example is for local development.
APP_ENV=development
# Anonymous mode is deliberately off. Set to 1 only for a trusted local/test
# runtime. It is ignored in production, where complete Google auth is required.
# Together with a non-production APP_ENV (development/local/test) it is also the
# only way the agent, scheduler and CLIs may act without naming an account (the
# local single-user tenant). Any other setting means every process must be given
# an account, and there is no shared fallback user. See docs/USER_MODEL.md.
ALLOW_ANONYMOUS_WEB=0
# Port the web dashboard listens on (host mapping). Defaults vary by compose file:
#   docker-compose.yml -> 8770, docker-compose.portainer.yml -> 8088
WEB_PORT=
# Canonical public origin used for OAuth redirects and absolute URLs.
# Required in production and must use HTTPS. Do not include a path.
# Example: https://workout.example.com
WEB_PUBLIC_URL=
# Optional comma-separated public host aliases accepted in the Host header.
# WEB_PUBLIC_URL's host is always accepted and remains the canonical output host.
WEB_ALLOWED_HOSTS=
# Comma-separated CIDRs for reverse proxies permitted to supply forwarding
# headers. Keep this as narrow as possible. Empty means trust no proxy headers.
# Example for a single Docker bridge peer: 172.18.0.1/32
WEB_TRUSTED_PROXY_CIDRS=
# Complete Google Login configuration. In production all three values are
# required; partial configuration is rejected before the server starts.
WEB_GOOGLE_CLIENT_ID=
WEB_GOOGLE_CLIENT_SECRET=
# Generate a strong session secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_AUTH_SECRET=
# Account access policy, enforced on the server at sign-in and on every request
# (see docs/ACCOUNT_ACCESS_POLICY.md).
# Comma-separated Google addresses allowed to sign in. Matching is
# case-insensitive. Leave empty for no allowlist. Removing an address ends that
# person's sessions the next time the service starts (and refuses them at once).
# A malformed entry stops startup instead of silently opening access.
ALLOWED_EMAILS=
# 1 = a new account is created only for an address with a pending, unexpired
# invitation (create one with `python scripts/manage_accounts.py invite ...`).
# Existing accounts are unaffected. 0 or empty = open registration.
INVITE_ONLY=0
# Browser session limits, in seconds (60 to 7776000). Both are enforced on the
# server against a revocable session registry, independent of the cookie's own
# expiry. IDLE ends a session after that long without a request. ABSOLUTE ends
# it that long after sign-in however active it has been, and must be at least
# IDLE. Blank uses the defaults shown. See docs/SESSION_SECURITY.md.
SESSION_IDLE_TIMEOUT_SECONDS=259200
SESSION_ABSOLUTE_TIMEOUT_SECONDS=1209600

# --- Account recovery email delivery ---
# Recovery links and verified email-change notices are sent through SMTP.
# Leave SMTP_HOST/SMTP_FROM unset to disable delivery; recovery requests still
# return a generic response, but no message is sent and no token is useful.
# Use SMTP_USE_SSL=1 for implicit TLS (usually port 465) or leave SMTP_USE_TLS=1
# for STARTTLS on the submission port (usually 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# --- Account and health-data deletion (docs/ACCOUNT_DELETION.md) ---
# Days between a user confirming an account closure and the irreversible erasure.
# The user can cancel during this window. Range 0-30, default 7; 0 erases at once.
# Health-data erasure is always immediate. The scheduler process performs the
# deferred erasure, so it must be running.
ACCOUNT_DELETION_GRACE_DAYS=7
# Days the anonymous deletion tombstone is kept as evidence. Range 35-3650,
# default 365. Keep it at least as long as your backup retention so a restore can
# be reconciled with `python backend/account_deletion.py reconcile`.
ACCOUNT_TOMBSTONE_RETENTION_DAYS=365

# --- Security audit log ---
# Key (at least 32 characters) for the tamper-evident security audit chain and
# for pseudonymising client addresses. Optional: when unset, a key is derived from
# WEB_AUTH_SECRET, so production is always keyed. Set a dedicated value so audit
# verification survives a session-secret rotation. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Verify the chain with: python backend/scripts/verify_security_audit.py
# See docs/SECURITY_AUDIT_LOGGING.md.
AUDIT_LOG_HMAC_KEY=

# --- Credential vault encryption ---
# REQUIRED in production. Every per-user AI provider key, connector API key and
# OAuth token is sealed with AES-256-GCM under a key derived for its owner. The
# vault fails closed: with no valid key, credentials cannot be saved or used.
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing the key makes existing credentials unreadable (re-enter them in
# Settings); there is intentionally no silent re-keying.
ENCRYPTION_KEY=

# --- Autonomous Development ---
# GitHub token used by repository maintenance scripts. Also read as GH_TOKEN; set only one.
GITHUB_TOKEN=
GH_TOKEN=

# --- Autonomous Implementation Queue ---
# The OpenHands Agent Canvas on the VPS is the only component that may select
# implementation work. These settings control its claim leases. See
# docs/AUTONOMOUS_QUEUE_CONTRACT.md.
# Path to the queue ledger.
AGENT_QUEUE_DB=
# Claim lease duration in seconds (default 1800).
AGENT_QUEUE_LEASE_SECONDS=
# Heartbeat interval in seconds (default 300).
AGENT_QUEUE_HEARTBEAT_SECONDS=
# Attempts before an issue is blocked for a human (default 3).
AGENT_QUEUE_MAX_ATTEMPTS=
# Label that makes an issue eligible for autonomous implementation.
AGENT_QUEUE_ELIGIBLE_LABEL=
