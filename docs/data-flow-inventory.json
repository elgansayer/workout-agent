  "privacy_notice": "docs/PRIVACY.md",
  "owner": "deployment-operator",
  "data_classes": {
    "identity": "Account identity, preferences and session metadata",
    "workout": "Exercises, routines, sets, loads, programmes and training history",
    "health": "Body metrics, sleep, recovery, readiness and activity data",
    "coaching": "Goals, constraints, chat, prompts, recommendations and feedback",
    "credentials": "API keys, OAuth tokens, cookies and push credentials",
    "notification": "Delivery addresses, chat identifiers and push subscriptions",
    "operational": "Audit, security, sync status, request IDs and diagnostic metadata"
  },
  "processors": [
    {"id": "self", "name": "Workout Agent deployment", "role": "application and storage"},
    {"id": "hevy", "name": "Hevy", "role": "workout source"},
    {"id": "google", "name": "Google", "role": "identity, health and Gemini AI provider"},
    {"id": "anthropic", "name": "Anthropic", "role": "Claude AI provider"},
    {"id": "openai", "name": "OpenAI", "role": "AI provider"},
    {"id": "deepseek", "name": "DeepSeek", "role": "AI provider"},
    {"id": "garmin", "name": "Garmin", "role": "health and training source"},
    {"id": "oura", "name": "Oura", "role": "health source"},
    {"id": "polar", "name": "Polar", "role": "health source"},
    {"id": "withings", "name": "Withings", "role": "health source"},
    {"id": "telegram", "name": "Telegram", "role": "notification delivery"},
    {"id": "push", "name": "Browser push service", "role": "notification delivery"}
  ],
  "systems": [
    {"id": "browser", "name": "User browser / Angular UI", "category": "client", "processor": "self", "data_classes": ["identity", "workout", "health", "coaching", "notification"], "purposes": ["user interface", "local session", "user-requested actions"], "retention": "session/browser lifetime; personalised responses must not be persistently cached", "code_refs": ["frontend/src/app", "backend/webapp/static/sw.js"]},
    {"id": "fastapi", "name": "FastAPI backend", "category": "application", "processor": "self", "data_classes": ["identity", "workout", "health", "coaching", "credentials", "notification", "operational"], "purposes": ["authentication", "business logic", "connector orchestration", "coaching"], "retention": "request lifetime except records explicitly persisted", "code_refs": ["backend/webapp/app.py"]},
    {"id": "sqlite", "name": "Configured application database", "category": "storage", "processor": "self", "data_classes": ["identity", "workout", "health", "coaching", "credentials", "notification", "operational"], "purposes": ["authoritative product storage"], "retention": "until application/operator deletion; backups follow deployment policy", "code_refs": ["backend/database.py"]},
    {"id": "google_identity", "name": "Google identity", "category": "identity", "processor": "google", "integration_key": "google_identity", "data_classes": ["identity", "credentials"], "purposes": ["sign-in"], "retention": "OAuth/session lifecycle plus provider policy", "code_refs": ["backend/webapp/app.py"]},
    {"id": "hevy", "name": "Hevy", "category": "training-source", "processor": "hevy", "integration_key": "hevy", "data_classes": ["workout", "credentials", "operational"], "purposes": ["import workouts and routines"], "retention": "imported records persist in application storage until deletion; provider keeps its own copy", "code_refs": ["backend/hevy_reader.py"]},
    {"id": "google_health", "name": "Google Health / Fitbit legacy OAuth path", "category": "health-source", "processor": "google", "integration_key": "google_health", "data_classes": ["health", "credentials", "operational"], "purposes": ["import health and activity data"], "retention": "imported records follow application retention; provider tokens until disconnect/revocation", "code_refs": ["backend/google_health_auth.py", "backend/webapp/app.py"]},
    {"id": "fitbit", "name": "Fitbit connector", "category": "health-source", "processor": "google", "integration_key": "fitbit", "data_classes": ["health", "credentials", "operational"], "purposes": ["import health and activity data"], "retention": "imported records follow application retention; tokens until disconnect/revocation", "code_refs": ["backend/connectors/fitbit.py"]},
    {"id": "garmin", "name": "Garmin connectors", "category": "health-source", "processor": "garmin", "integration_key": "garmin", "data_classes": ["health", "workout", "credentials", "operational"], "purposes": ["import health and training data"], "retention": "imported records follow application retention; credentials until disconnect/revocation", "code_refs": ["backend/connectors/garmin.py"]},
    {"id": "oura", "name": "Oura connector", "category": "health-source", "processor": "oura", "integration_key": "oura", "data_classes": ["health", "credentials", "operational"], "purposes": ["import health and recovery data"], "retention": "imported records follow application retention; tokens until disconnect/revocation", "code_refs": ["backend/connectors/oura.py"]},
    {"id": "polar", "name": "Polar connector", "category": "health-source", "processor": "polar", "integration_key": "polar", "data_classes": ["health", "workout", "credentials", "operational"], "purposes": ["import health and training data"], "retention": "imported records follow application retention; tokens until disconnect/revocation", "code_refs": ["backend/connectors/polar.py"]},
    {"id": "withings", "name": "Withings connector", "category": "health-source", "processor": "withings", "integration_key": "withings", "data_classes": ["health", "credentials", "operational"], "purposes": ["import body and health data"], "retention": "imported records follow application retention; tokens until disconnect/revocation", "code_refs": ["backend/connectors/withings.py"]},
    {"id": "gemini", "name": "Google Gemini", "category": "ai-provider", "processor": "google", "integration_key": "gemini", "data_classes": ["coaching", "workout", "health"], "purposes": ["optional AI coaching"], "retention": "request/provider-policy dependent; do not send credentials", "code_refs": ["backend/ai_provider.py"]},
    {"id": "claude", "name": "Anthropic Claude", "category": "ai-provider", "processor": "anthropic", "integration_key": "claude", "data_classes": ["coaching", "workout", "health"], "purposes": ["optional AI coaching"], "retention": "request/provider-policy dependent; do not send credentials", "code_refs": ["backend/ai_provider.py"]},
    {"id": "openai", "name": "OpenAI", "category": "ai-provider", "processor": "openai", "integration_key": "openai", "data_classes": ["coaching", "workout", "health"], "purposes": ["optional AI coaching"], "retention": "request/provider-policy dependent; do not send credentials", "code_refs": ["backend/ai_provider.py"]},
    {"id": "deepseek", "name": "DeepSeek", "category": "ai-provider", "processor": "deepseek", "integration_key": "deepseek", "data_classes": ["coaching", "workout", "health"], "purposes": ["optional AI coaching"], "retention": "request/provider-policy dependent; do not send credentials", "code_refs": ["backend/ai_provider.py"]},
    {"id": "telegram", "name": "Telegram", "category": "notification", "processor": "telegram", "integration_key": "telegram", "data_classes": ["notification", "coaching", "workout"], "purposes": ["optional user notifications"], "retention": "delivery metadata follows application/provider policy", "code_refs": ["backend/telegram_notifier.py"]},
    {"id": "web_push", "name": "Web Push", "category": "notification", "processor": "push", "integration_key": "web_push", "data_classes": ["notification", "coaching", "workout"], "purposes": ["optional browser notifications"], "retention": "subscription until revoked/expired; delivered messages follow browser push service policy", "code_refs": ["backend/database.py", "backend/webapp/app.py"]}
  ],
  "data_flows": [
    {"id": "ui-api", "source": "browser", "destination": "fastapi", "data_classes": ["identity", "workout", "health", "coaching", "credentials", "notification"], "purpose": "authenticated application use"},
    {"id": "api-db", "source": "fastapi", "destination": "sqlite", "data_classes": ["identity", "workout", "health", "coaching", "credentials", "notification", "operational"], "purpose": "persist user-scoped product state"},
    {"id": "hevy-import", "source": "hevy", "destination": "fastapi", "data_classes": ["workout", "operational"], "purpose": "import workouts and routines"},
    {"id": "google-health-import", "source": "google_health", "destination": "fastapi", "data_classes": ["health", "operational"], "purpose": "import health data"},
    {"id": "fitbit-import", "source": "fitbit", "destination": "fastapi", "data_classes": ["health", "operational"], "purpose": "import health data"},
    {"id": "garmin-import", "source": "garmin", "destination": "fastapi", "data_classes": ["health", "workout", "operational"], "purpose": "import health and training data"},
    {"id": "oura-import", "source": "oura", "destination": "fastapi", "data_classes": ["health", "operational"], "purpose": "import health and recovery data"},
    {"id": "polar-import", "source": "polar", "destination": "fastapi", "data_classes": ["health", "workout", "operational"], "purpose": "import health and training data"},
    {"id": "withings-import", "source": "withings", "destination": "fastapi", "data_classes": ["health", "operational"], "purpose": "import body and health data"},
    {"id": "gemini-coaching", "source": "fastapi", "destination": "gemini", "data_classes": ["coaching", "workout", "health"], "purpose": "optional AI coaching"},
    {"id": "claude-coaching", "source": "fastapi", "destination": "claude", "data_classes": ["coaching", "workout", "health"], "purpose": "optional AI coaching"},
    {"id": "openai-coaching", "source": "fastapi", "destination": "openai", "data_classes": ["coaching", "workout", "health"], "purpose": "optional AI coaching"},
    {"id": "deepseek-coaching", "source": "fastapi", "destination": "deepseek", "data_classes": ["coaching", "workout", "health"], "purpose": "optional AI coaching"},
    {"id": "telegram-delivery", "source": "fastapi", "destination": "telegram", "data_classes": ["notification", "coaching", "workout"], "purpose": "optional notifications"},
    {"id": "push-delivery", "source": "fastapi", "destination": "web_push", "data_classes": ["notification", "coaching", "workout"], "purpose": "optional browser notifications"}
  ]
